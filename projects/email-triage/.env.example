# =============================================================================
# Email Triage System One - Environment Configuration
# =============================================================================

# Decision Provider ('cloudflare', 'vercel', 'openrouter', or 'auto')
DECISION_PROVIDER=cloudflare

# Decision Model:
# Cloudflare options: '@cf/cloudflare/clef-flash' (9B, fast) or '@cf/cloudflare/clef' (27B)
# Vercel AI Gateway Free Tier: 'convaiinnovations/laya-free' or 'typesafe-ai/jev'
# OpenRouter options: 'typesafe/jev-1.13'
DECISION_MODEL=@cf/cloudflare/clef-flash

# Vercel AI Gateway Credentials (Free Tier Decision Models & Credits)
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# Cloudflare Workers AI Credentials (for Clef & Clef-Flash)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_GATEWAY_ID=  # Optional AI Gateway slug

# OpenRouter Credentials (for TypeSafe Jev)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Himalaya IMAP CLI binary path
HIMALAYA_BIN=himalaya

# Storage & Network
EMAIL_TRIAGE_DATA_DIR=  # Defaults to ~/.local/share/system-one-projects/email-triage
PORT=8085
HOST=0.0.0.0
